<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:theme="@style/LaunchTheme.AppWidgetContainer"
              android:orientation="vertical"
              android:id="@id/all_4x4_home_app_widget"
              android:background="@drawable/bg_4x4"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:gravity="center_vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dp"
                android:layout_marginBottom="8.0dp"
                android:layout_marginStart="16.0dp"
                android:layout_marginEnd="8.0dp"
                android:layout_marginVertical="8.0dp">
    <ImageView android:layout_width="59.0dp"
               android:layout_height="24.0dp"
               android:src="@drawable/logo_mb_white"
               android:importantForAccessibility="no" />
    <LinearLayout android:background="#00000000"
                  android:layout_width="0.0dp"
                  android:layout_height="32.0dp"
                  android:layout_weight="1.0" />
    <ImageButton android:id="@id/all_4x4_button_open_app"
                 android:layout_width="48.0dp"
                 android:layout_height="48.0dp"
                 android:src="@drawable/arrow"
                 android:importantForAccessibility="no"
                 android:backgroundTint="#00000000" />
  </LinearLayout>
  <LinearLayout android:background="#ffffff"
                android:layout_width="fill_parent"
                android:layout_height="1.0dp" />
  <LinearLayout android:orientation="horizontal"
                android:id="@id/all_4x4_qr_info_layout_init"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="148.0dp"
                android:layout_marginLeft="16.0dp"
                android:layout_marginTop="16.0dp"
                android:layout_marginRight="16.0dp"
                android:layout_marginBottom="24.0dp"
                android:layout_marginHorizontal="16.0dp">
    <TextView 
	      android:textColor="#ffffff"
	      android:layout_width="0.0dp"
              android:layout_height="148.0dp"
              android:text="@string/text_click_setting_qr"
              android:layout_weight="1.0"
              style="@style/TextStyleHint" />
    <ImageView android:background="@drawable/border_radius_12"
               android:padding="20.0dp"
               android:layout_width="148.0dp"
               android:layout_height="148.0dp"
               android:src="@drawable/default_qr_2x2"
               android:scaleType="fitCenter"
               android:importantForAccessibility="no" />
  </LinearLayout>
  <LinearLayout android:orientation="horizontal"
                android:id="@id/all_4x4_qr_info_layout"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="148.0dp"
                android:layout_marginLeft="16.0dp"
                android:layout_marginTop="16.0dp"
                android:layout_marginRight="16.0dp"
                android:layout_marginBottom="24.0dp"
                android:layout_marginHorizontal="16.0dp">
    <LinearLayout android:orientation="vertical"
                  android:layout_width="0.0dp"
                  android:layout_height="fill_parent"
                  android:layout_weight="1.0"
                  android:textAlignment="textStart"
                  android:layout_marginEnd="8.0dp">
      <TextView 
		android:ellipsize="end"
		android:textColor="#ffffff"
                android:id="@id/all_4x4_text_account_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_account_name"
                android:maxLines="1"
                style="@style/TextStyleAccountName" />
      <TextView android:ellipsize="end"
		android:textColor="#ffffff"		
		android:id="@id/all_4x4_text_account_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_account_number"
                android:maxLines="1"
                style="@style/TextStyleAccountNumber" />
    </LinearLayout>
    <ImageView android:id="@id/all_4x4_image_qr"
               android:background="@drawable/border_radius_12"
               android:padding="6.0dp"
               android:layout_width="148.0dp"
               android:layout_height="148.0dp"
               android:src="@drawable/default_qr_2x2"
               android:scaleType="fitCenter"
               android:importantForAccessibility="no" />
  </LinearLayout>
  <LinearLayout android:gravity="center_horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16.0dp"
                android:layout_marginRight="16.0dp"
                android:layout_marginBottom="24.0dp"
                android:baselineAligned="false"
                android:layout_marginHorizontal="16.0dp">
    <TextView android:id="@id/all_4x4_button_transfer"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/text_transfer"
              android:drawableTop="@drawable/move_money"
              android:drawablePadding="6.0dp"
              android:layout_weight="1.0"
              style="@style/TextStyle" />
    <TextView android:id="@id/all_4x4_button_scan_qr"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/text_scan_qr"
              android:drawableTop="@drawable/scan_qr_2"
              android:drawablePadding="6.0dp"
              android:layout_weight="1.0"
              style="@style/TextStyle" />
    <TextView android:id="@id/all_4x4_button_phone_recharge"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/text_phone_recharge"
              android:drawableTop="@drawable/topup"
              android:drawablePadding="6.0dp"
              android:layout_weight="1.0"
              android:textAlignment="center"
              style="@style/TextStyle" />
    <TextView android:id="@id/all_4x4_button_online_loan"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/text_online_loan"
              android:drawableTop="@drawable/loan"
              android:drawablePadding="6.0dp"
              android:layout_weight="1.0"
              android:textAlignment="center"
              style="@style/TextStyle" />
  </LinearLayout>
</LinearLayout>
